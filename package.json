{
  "name": "llm-gateway",
  "version": "1.0.0",
  "description": "Minimal LLM Gateway with virtual API keys, per-key budgets, and resilient fallback",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx scripts/migrate.ts",
    "test": "vitest run"
  },
  "keywords": [
